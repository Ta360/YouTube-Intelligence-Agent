# ─── Server ────────────────────────────────────────────────────────────────
API_PORT=4300
NODE_ENV=development
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5473

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local dev: `npm run dev` starts an embedded PostgreSQL at this URL automatically.
DATABASE_URL=postgresql://yia:yia_local_dev@localhost:5435/youtube_intel

# ─── YouTube Data API v3 (required for live data) ──────────────────────────
# Create a key: Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
# auto       → use the API when YOUTUBE_API_KEY is set, otherwise labelled DEMO DATA
# youtube    → always use the API (fails with a clear error if the key is missing)
# mock       → always DEMO DATA, no API calls
YOUTUBE_API_MODE=auto
YOUTUBE_API_KEY=
# Daily quota of your Google Cloud project (default 10,000 units; search = 100 units, most other calls = 1)
YOUTUBE_DAILY_QUOTA=10000
# Region used for video categories
YOUTUBE_REGION=US
# Seconds to cache YouTube responses (reduces quota use)
YOUTUBE_CACHE_TTL_SECONDS=1800

# ─── Web search (optional — broader internet research by the AI agent) ─────
# serper (https://serper.dev) or tavily (https://tavily.com)
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=

# ─── AI agent (optional) ───────────────────────────────────────────────────
# LLM_PROVIDER=openai uses OPENAI_API_KEY. Without a key the agent uses a built-in
# natural-language parser that runs the same research workflow.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Dashboard accounts ────────────────────────────────────────────────────
# The FIRST account can always sign up. After that sign-up is closed unless ALLOW_SIGNUP=true.
ALLOW_SIGNUP=false
# Optional: only this email may create the FIRST account (set it for any public deployment).
OWNER_EMAIL=
# Required in production: a random string of at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string
